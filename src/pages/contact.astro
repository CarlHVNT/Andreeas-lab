---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import ConsultationForm from "@/components/ConsultationForm.astro";
import MapEmbed from "@/components/MapEmbed.astro";
import Mark from "@/components/Mark.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { addressLines } from "@/lib/address";

const { contact, location } = SITE;
---

<BaseLayout
  title="Contact"
  description={`Message Andreea on WhatsApp, send a consultation request, or find the treatment room at ${location.building}, ${location.area}, Dubai. Hours, address and directions.`}
  hasHero
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-5">
      <Mark class="mb-4" />
      <h1 class="text-statement">Message Andreea</h1>
      <p class="voice mt-5">
        WhatsApp is the quickest way. Say what you would like help with, and Andreea replies personally,
        usually the same day.
      </p>
      <figure class="arch mt-10 aspect-[4/5] max-w-[18rem] bg-stone">
        <Image
          src={photos.tunic.src}
          alt={photos.tunic.alt}
          widths={[320, 480, 720]}
          sizes="18rem"
          loading="lazy"
          class="h-full w-full object-cover"
          style={`object-position:${photos.tunic.position}`}
        />
      </figure>
    </header>
    <div class="mt-8 flex flex-col items-start gap-4 md:col-span-6 md:col-start-7 md:mt-0 md:pt-2">
      <WhatsAppButton id="hero-cta" />
      <p class="text-facts text-graphite">
        Or call or save the number:
        <a href={`tel:${contact.whatsappNumber}`} class="text-ink tabular-nums underline hover:text-lab">
          {contact.whatsappDisplay}
        </a>
      </p>
      {
        contact.email && (
          <p class="text-facts text-graphite">
            Email:
            <a href={`mailto:${contact.email}`} class="text-ink underline hover:text-lab">
              {contact.email}
            </a>
          </p>
        )
      }
    </div>
  </section>

  <Section title="Or send a request" tone="mist">
    <p slot="statement" class="voice mt-4 max-w-[34ch] text-graphite">
      If you would rather not open WhatsApp now, leave your details and Andreea will message you.
    </p>
    <ConsultationForm />
  </Section>

  <Section title="Where to find me">
    <div slot="statement" class="mt-6 grid gap-6 text-facts">
      <address class="not-italic">
        <p class="font-medium">{location.hostClinic || SITE.name}</p>
        <p class="text-graphite">
          {addressLines.map((line) => <span class="block">{line}</span>)}
          {location.makani && <span class="block tabular-nums">Makani {location.makani}</span>}
        </p>
      </address>
      <div>
        <p class="font-medium">Hours</p>
        <dl class="mt-1.5 grid gap-1.5 tabular-nums">
          {
            SITE.hours.map((h) => (
              <div class="flex justify-between gap-6 border-b border-stone pb-1.5 md:max-w-[22rem]">
                <dt class="text-graphite">{h.label}</dt>
                <dd>{h.closed ? "Closed" : `${h.opens} to ${h.closes}`}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <p class="font-medium">Finding the room</p>
        <p class="max-w-[40ch] text-graphite">{location.howToFind}</p>
      </div>
      <div>
        <p class="font-medium">Parking</p>
        <p class="max-w-[40ch] text-graphite">{location.parking}</p>
      </div>
    </div>
    <MapEmbed />
  </Section>
</BaseLayout>
