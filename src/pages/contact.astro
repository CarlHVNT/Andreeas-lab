---
/**
 * Contact, in Andreea’s words (via Carl, 19 September 2026): WhatsApp first,
 * then email. The address is not published: “Based in Dubai, UAE”. The request
 * form and the “Where to find me” section came off the same day.
 */
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import Mark from "@/components/Mark.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { whatsappLink } from "@/lib/whatsapp";

const { contact, location } = SITE;
---

<BaseLayout
  title="Contact"
  description={`Get in touch with Andreea in Dubai on WhatsApp (${contact.whatsappDisplay}) or by email, whether you are looking for the right treatment, need guidance with your skin, or want advice about a career in beauty and aesthetics.`}
  hasHero
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-6">
      <Mark class="mb-4" />
      <h1 class="text-statement">Let’s connect</h1>
      <div class="voice mt-5">
        <p>
          Whether you are looking for the right treatment, need guidance with your skin, or want professional
          advice about starting or developing your career in beauty and aesthetics, feel free to get in touch.
        </p>
        <p>
          Tell me briefly what you need help with, and I’ll personally come back to you with the best way to
          move forward.
        </p>
      </div>
      <figure class="arch mt-10 aspect-[4/5] max-w-[18rem] bg-linen">
        <Image
          src={photos.tunic.src}
          alt={photos.tunic.alt}
          widths={[320, 480, 720]}
          sizes="18rem"
          loading="lazy"
          class="h-full w-full object-cover"
          style={`object-position:${photos.tunic.position}`}
        />
      </figure>
    </header>
    <div class="mt-8 md:col-span-5 md:col-start-8 md:mt-0 md:pt-2">
      <WhatsAppButton id="hero-cta" />
      <dl class="mt-8 border-t border-linen text-facts">
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-linen py-3.5">
          <dt class="text-muted">WhatsApp</dt>
          <dd>
            <a href={whatsappLink()} class="text-ink tabular-nums underline hover:text-wine" target="_blank" rel="noopener">
              {contact.whatsappDisplay}
            </a>
          </dd>
        </div>
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-linen py-3.5">
          <dt class="text-muted">Email</dt>
          <dd>
            <a href={`mailto:${contact.email}`} class="break-all text-ink underline hover:text-wine">{contact.email}</a>
          </dd>
        </div>
      </dl>
      <p class="mt-5 text-facts text-muted">Based in {location.city}, UAE</p>
    </div>
  </section>
</BaseLayout>
