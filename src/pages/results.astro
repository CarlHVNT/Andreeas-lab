---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Quote from "@/components/Quote.astro";
import PhotoPair from "@/components/PhotoPair.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { getTestimonials, getTreatments } from "@/lib/content";

const testimonials = await getTestimonials();
const treatments = await getTreatments();
const titleFor = (slug?: string) => treatments.find((t) => t.id === slug)?.data.title;
const quotes = await Promise.all(
  testimonials.map(async (q) => ({ q, Content: (await render(q)).Content })),
);
const hasSamples = testimonials.some((t) => t.data.placeholder);
---

<BaseLayout
  title="Results"
  description="What clients of Andreea’s Lab say about Icoone lymphatic drainage, skin firming and post-surgery recovery in Dubai. Honest results, in their own words."
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-5">
      <Mark class="mb-4" />
      <h1 class="text-statement">Results, in their own words</h1>
      <div class="voice mt-5">
        <p>
          Icoone is not a miracle and I will never describe it as one. What it does, it does reliably when the
          course is planned and followed. These are the words of people who have been through one.
        </p>
        <p class="text-graphite">
          Results vary from person to person. Nothing here is a promise about yours. That is what the
          consultation is for.
        </p>
      </div>
      {
        hasSamples && (
          <p class="mt-6 text-meta text-graphite">
            The quotes on this page are samples for the layout review. Real quotes will be added with each
            client’s written consent.
          </p>
        )
      }
      <PhotoPair first={photos.mask} second={photos.collage} class="mt-10 max-w-[26rem]" />
    </header>
    <div class="mt-10 grid gap-10 md:col-span-6 md:col-start-7 md:mt-0">
      {
        quotes.map(({ q, Content }) => (
          <Quote
            name={q.data.name}
            area={q.data.area}
            treatment={titleFor(q.data.treatmentSlug)}
            date={q.data.date}
            placeholder={q.data.placeholder}
          >
            <Content />
          </Quote>
        ))
      }
    </div>
  </section>

  {
    SITE.results.showBeforeAfters && (
      <section class="pt-18 md:pt-32">
        <div class="mx-auto max-w-content px-5 md:px-6">
          <h2 class="text-statement">Before and after</h2>
          <p class="voice mt-4">Photographs shared with each client’s written consent. Placeholder section.</p>
        </div>
      </section>
    )
  }

  <CtaBand
    title="Your turn."
    text="Tell Andreea what you would like to change. She will tell you honestly what Icoone can do for it, and what it cannot."
  />
</BaseLayout>
