---
import BaseLayout from "@/layouts/BaseLayout.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:gap-6 md:px-6 md:pt-16">
    <div class="md:col-span-7">
      <h1 class="text-statement">That page is not here.</h1>
      <p class="voice mt-5">The link may be old, or the address mistyped. Everything on the site is one tap away.</p>
      <ul class="mt-8 grid gap-3">
        <li><a href="/" class="link-arrow"><span>Home</span><IconArrow class="h-4.5 w-4.5" /></a></li>
        <li><a href="/treatments" class="link-arrow"><span>Treatments</span><IconArrow class="h-4.5 w-4.5" /></a></li>
        <li><a href="/contact" class="link-arrow"><span>Contact</span><IconArrow class="h-4.5 w-4.5" /></a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
