---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PhotoPair from "@/components/PhotoPair.astro";
import InstagramGrid from "@/components/InstagramGrid.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { venue } from "@/lib/address";

const { practitioner, location } = SITE;
---

<BaseLayout
  title="About Andreea"
  description="Andreea is a DHA-licensed beauty therapist in Dubai: advanced facial and body treatments, skin health, facial sculpting and aesthetic technologies. Personal, practical and honest."
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-5 md:pt-6">
      <Mark class="mb-4" />
      <!-- Andreea’s own words, set exactly as she wrote them (19 September 2026). The title case on the
           subtitle is hers and is the one agreed exception to the sentence-case rule. -->
      <h1 class="text-statement">I’m Andreea.</h1>
      <p class="mt-3 font-serif text-title">The Professional Behind Andreea’s Lab</p>
      <div class="voice mt-6">
        <p>
          I’m an aesthetic professional based in Dubai, specialising in advanced facial and body treatments, skin
          health, facial sculpting and aesthetic technologies. I have lived and worked in the UAE for more than ten
          years.
        </p>
        <p>
          I believe good results start with understanding the person, not simply choosing a treatment. My approach
          is personal, practical and honest — I look at what you want to improve, what is suitable for you, and what
          can realistically achieve the best result.
        </p>
        <p>
          Andreea’s Lab brings together my work with clients and the professional knowledge I have built throughout
          my career in the beauty and aesthetics industry.
        </p>
      </div>
    </header>
    <figure class="arch mt-10 aspect-[4/5] bg-linen md:col-span-6 md:col-start-7 md:mt-0">
      <Image
        src={photos.tunic.src}
        alt={photos.tunic.alt}
        widths={[480, 768, 1024, 1290]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
        style={`object-position:${photos.tunic.position}`}
      />
    </figure>
  </section>

  <Section title="Where I trained">
    <!-- Andreea’s own words (17 September 2026). Edit here when she sends changes. -->
    <div class="voice">
      <p>
        I completed my professional beauty therapy training in the UAE at The Nordic International Beauty &amp;
        Training Centre, including an ITEC Level 3 UK qualification, alongside professional training recognised
        within the UAE regulatory framework.
      </p>
      <p>
        My professional focus is advanced facial and acne treatments, facial massage and sculpting techniques,
        lymphatic therapies, and Icoone Medical treatments. I continue to develop my skills through specialised
        hands-on training and professional education in the UAE and internationally.
      </p>
    </div>
    <ul class="mt-8 divide-y divide-linen border-y border-linen text-facts" role="list">
      <li class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-6">
        <span class="text-muted">Qualification</span>
        <span>{practitioner.title}</span>
      </li>
      <li class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-6">
        <span class="text-muted">Specialisations</span>
        <span>{practitioner.specialisations.join(" · ")}</span>
      </li>
      <li class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-6">
        <span class="text-muted">Languages</span>
        <span>{practitioner.languages.join(", ")}</span>
      </li>
    </ul>
    <a href="/qualifications" class="link-arrow mt-6">
      <span>Specialisations and qualifications in full</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>

  <Section title="Why choose Andreea" tone="white">
    <PhotoPair slot="statement" first={photos.device} second={photos.forehead} class="mt-8 max-w-[26rem]" />
    <!-- Andreea’s own words, set exactly as she wrote them (19 September 2026) -->
    <div class="voice">
      <p>
        I don’t believe in doing more — I believe in doing what is right. Every treatment is chosen with purpose,
        adapted to the individual and supported by honest advice. My goal is simple: understand your concern,
        choose the right approach and never recommend something you do not truly need.
      </p>
    </div>
  </Section>

  <Section title="The Andreea’s Lab Method">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">Results with a plan.</p>
    <!-- Andreea’s own words, set exactly as she wrote them (19 September 2026) -->
    <div class="voice">
      <p>
        Every plan starts with a consultation, a clear goal and realistic expectations. I assess your skin, face or
        body, choose the right treatment or combination, and review your progress along the way.
      </p>
      <p>
        If something is not working, we adjust the plan. If we reach the goal, we move to maintenance instead of
        continuing treatments you no longer need.
      </p>
    </div>
    <figure class="mt-10">
      <div class="aspect-[4/3] overflow-hidden bg-linen">
        <Image
          src={photos.clinic.src}
          alt={photos.clinic.alt}
          widths={[480, 768, 1024, 1290]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover"
          style="object-position:center 45%"
        />
      </div>
      <figcaption class="mt-3 text-meta text-muted">
        The room at {venue}, {location.area}.
      </figcaption>
    </figure>
  </Section>

  <Section title="On Instagram" tone="blush">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">
      Case studies, real talk and what I am reading. No hype.
    </p>
    <InstagramGrid />
  </Section>

  <CtaBand
    title="Come and meet me."
    text="Message me with what you would like to change. I reply personally, usually the same day, and the first conversation is just that: a conversation."
  />
</BaseLayout>
