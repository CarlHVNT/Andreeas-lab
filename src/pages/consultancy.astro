---
/**
 * Consultancy: Andreea’s professional knowledge for other people in the
 * beauty and aesthetics industry. Draft copy in her voice, built from facts
 * already on the site; the list of areas and the steps need her confirmation
 * (see CONTENT-TODO.md). WhatsApp messages from this page say “consultancy”.
 */
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Steps from "@/components/Steps.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import LineIcon from "@/components/icons/LineIcon.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { serviceJsonLd } from "@/lib/seo";

const topic = "consultancy";

const areas = [
  {
    icon: "clipboard",
    title: "Treatment planning and programmes",
    text: "How I plan a programme, measure it and adjust it, and how to explain all of that to a client.",
  },
  {
    icon: "person",
    title: "Facial and body treatment technique",
    text: "Hands-on time on the work I specialise in: advanced facials, facial massage and sculpting, and lymphatic therapies.",
  },
  {
    icon: "refresh",
    title: "Working with technology",
    text: "Choosing, learning and getting the most from devices such as Icoone, and knowing when not to use them.",
  },
  {
    icon: "chat",
    title: "Talking to clients plainly",
    text: "Consultations, expectations, aftercare and saying no. The part of the job that decides whether people come back.",
  },
  {
    icon: "shield",
    title: "Starting out in Dubai",
    text: "The practical side of setting up and running a one-practitioner studio here, from someone who has done it.",
  },
] as const;

const steps = [
  {
    title: "Message me",
    text: "Tell me what you are working on and what you want from it, on WhatsApp or by email.",
  },
  {
    title: "A first conversation",
    text: "We talk it through. I ask questions and tell you honestly whether I am the right person to help.",
  },
  {
    title: "A proposal in writing",
    text: "What we will cover, how long it takes, where we meet and what it costs. Nothing starts before you have it.",
  },
];

const description =
  "Consultancy from Andreea, a DHA-licensed beauty therapist in Dubai with more than ten years in the UAE: treatment programmes, technique, technology and talking to clients, for professionals and businesses in beauty and aesthetics.";
const jsonLd = [
  serviceJsonLd({
    name: "Consultancy",
    description,
    url: `${SITE.url}/consultancy`,
    serviceType: "Consultancy for beauty and aesthetics professionals",
  }),
];
---

<BaseLayout title="Consultancy for beauty and aesthetics professionals" description={description} treatment={topic} jsonLd={jsonLd}>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-6 md:pt-6">
      <Mark class="mb-4" />
      <h1 class="text-statement">Consultancy</h1>
      <div class="voice mt-6">
        <p>
          Alongside my work with clients, I share what I have learned with other professionals and businesses in
          beauty and aesthetics: more than ten years in the UAE, professional training, and the daily reality of
          running a one-practitioner studio in Dubai.
        </p>
        <p>
          If you are starting out, adding treatments or technology, or want an honest second opinion on how you
          work with clients, tell me what you are working on. I will say plainly whether I can help.
        </p>
      </div>
    </header>
    <figure class="arch mt-10 aspect-[4/5] bg-linen md:col-span-5 md:col-start-8 md:mt-0">
      <Image
        src={photos.clinic.src}
        alt={photos.clinic.alt}
        widths={[480, 768, 1024, 1290]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
        style={`object-position:${photos.clinic.position}`}
      />
    </figure>
  </section>

  <Section title="What I can help with" tone="white">
    <p slot="statement" class="voice mt-4 max-w-[34ch] text-muted">
      The same things I do in the room every week, shared one to one.
    </p>
    <ul class="divide-y divide-linen border-y border-linen" role="list">
      {
        areas.map((a) => (
          <li class="grid grid-cols-[2.75rem_1fr] gap-4 py-5">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-blush text-wine" aria-hidden="true">
              <LineIcon name={a.icon} class="h-5.5 w-5.5" />
            </span>
            <div>
              <h3 class="text-title font-medium">{a.title}</h3>
              <p class="mt-1.5 max-w-[52ch] text-muted">{a.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title="How it works">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">Three steps, and nothing starts before the third.</p>
    <Steps steps={steps} />
  </Section>

  <CtaBand
    title="Tell me what you are working on."
    text="Message me with a few lines about your practice or your business and what you would like help with. I reply personally, usually the same day."
    treatment={topic}
  />
</BaseLayout>
