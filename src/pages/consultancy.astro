---
/**
 * Consultancy: Andreea’s book first, then the three kinds of personal guidance
 * she offers people in the beauty and aesthetics industry. Structure and copy
 * from Andreea via Carl, 19 September 2026, set in her words. WhatsApp
 * messages from this page say “consultancy”; “Get the book” goes to `SITE.book.url`
 * (Amazon), or opens WhatsApp if that is ever emptied.
 */
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { whatsappLink } from "@/lib/whatsapp";
import { serviceJsonLd } from "@/lib/seo";

const topic = "consultancy";
const { book } = SITE;
const bookHref = book.url || whatsappLink("the book");

// Andreea’s own words (19 September 2026)
const guidance = [
  {
    title: "Starting your career",
    text: "For students and newly qualified beauty therapists who need direction on qualifications, licensing, employment and their next professional steps.",
  },
  {
    title: "Already working in beauty",
    text: "For therapists looking for practical guidance on products, protocols, devices and what I have learned from working with different treatments — the Andreea’s Lab approach.",
  },
  {
    title: "Starting a beauty business",
    text: "For new business owners who need practical guidance around treatment concepts, equipment, service menus and the licensing questions that should be clarified before launching.",
  },
];

const description = `Consultancy from Andreea, a DHA-licensed beauty therapist in Dubai: her book ${book.title} (${book.published}) and personal guidance for students, working therapists and new beauty business owners.`;
const jsonLd = [
  serviceJsonLd({
    name: "Consultancy",
    description,
    url: `${SITE.url}/consultancy`,
    serviceType: "Consultancy for beauty and aesthetics professionals",
  }),
];
---

<BaseLayout title="Consultancy" description={description} treatment={topic} jsonLd={jsonLd}>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-6 md:pt-6">
      <Mark class="mb-4" />
      <!-- The book’s title, in its own capitalisation -->
      <h1 class="text-statement">{book.title}</h1>
      <div class="voice mt-6">
        <p>
          In {book.published}, I published <em>{book.title}</em> — a practical guide covering many of the
          questions I had to learn through experience when entering the industry.
        </p>
      </div>
      <a href={bookHref} class="link-arrow mt-6" target="_blank" rel="noopener">
        <span>Get the book</span>
        <IconArrow class="h-4.5 w-4.5" />
      </a>
    </header>
    <!-- The book cover mock-up has a transparent ground, so it sits on the page without a frame -->
    <figure class="mt-10 md:col-span-5 md:col-start-8 md:mt-0">
      <Image
        src={photos.bookCover.src}
        alt={photos.bookCover.alt}
        widths={[480, 768, 1024]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full max-w-[22rem] md:max-w-none"
      />
    </figure>
  </section>

  <Section id="guidance" title="Need more personal guidance?" tone="white">
    <ul class="divide-y divide-linen border-y border-linen" role="list">
      {
        guidance.map((g) => (
          <li class="py-5">
            <h3 class="text-title font-medium">{g.title}</h3>
            <p class="mt-1.5 max-w-[56ch] text-muted">{g.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand
    title="Every situation is different."
    text="Tell me what you need help with and we can decide what type of consultation would be most useful for you."
    treatment={topic}
    contactLinkLabel="Contact Andreea"
    contactLinkHref="/contact"
  />
</BaseLayout>
