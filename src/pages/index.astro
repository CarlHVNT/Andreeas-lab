---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import TreatmentRows from "@/components/TreatmentRows.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import FaqList from "@/components/FaqList.astro";
import Gallery from "@/components/Gallery.astro";
import ImageBand from "@/components/ImageBand.astro";
import HeroVideo from "@/components/HeroVideo.astro";
import VideoEmbed from "@/components/VideoEmbed.astro";
import Mark from "@/components/Mark.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import IconInstagram from "@/components/icons/IconInstagram.astro";
import LineIcon from "@/components/icons/LineIcon.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { whatsappLink } from "@/lib/whatsapp";
import { getLocaleFromUrl, useTranslations } from "@/i18n/ui";
import SpecialisationList from "@/components/SpecialisationList.astro";
import { GUIDANCE } from "@/lib/consultancy";
import {
  getFeaturedTreatments,
  getFeaturedCaseStudies,
  getFaqsBySlugs,
} from "@/lib/content";

const t = useTranslations(getLocaleFromUrl(Astro.url));
const treatments = await getFeaturedTreatments(7);
const cases = SITE.results.showBeforeAfters ? await getFeaturedCaseStudies(3) : [];
const faqs = await getFaqsBySlugs(["nothing-worked", "acne-one-or-two-sessions", "melasma-disappear", "facial-sculpting-sessions"]);
const { location, practitioner, contact, podcast, youtube, book } = SITE;
const bookHref = book.url || whatsappLink("the book");

const why = [
  {
    icon: "person",
    title: "One expert, every time.",
    text: "You see Andreea at every session, from the first consultation to the last check-in. No rotating staff.",
  },
  {
    icon: "shield",
    title: "Licensed and certified.",
    text: `${practitioner.title}. ${practitioner.credentials.join(". ")}. Based in ${location.city}.`,
  },
  {
    icon: "clipboard",
    title: "A plan, not a pamper.",
    text: "Every programme starts with a consultation and a personalised plan: which treatment or combination of treatments, how many sessions, and clear expectations from the start.",
  },
  {
    icon: "heart",
    title: "Honest about results.",
    text: "No guarantees, no miracle language, and no pressure to add anything you did not come for.",
  },
] as const;

---

<!-- SEO title and description from Carl, 19 September 2026 -->
<BaseLayout title="Facial Treatments & Body Sculpting Dubai | Andreea’s Lab" description={SITE.description} hasHero>
  <!-- Hero: statement and one button over a silent background video -->
  <section class="hero relative overflow-hidden">
    <!-- Mirrored so the client’s face sits on the right, clear of the text scrim; the crop follows her face on phones -->
    <HeroVideo poster="/video/hero-poster.jpg" mp4="/video/hero.mp4" webm="/video/hero.webm" mirror position="24% center" />
    <div
      class="absolute inset-0 bg-linear-to-b from-ivory from-35% via-ivory/85 via-60% to-ivory/10 md:bg-linear-to-r md:from-ivory md:from-34% md:via-ivory/75 md:via-54% md:to-ivory/0"
      aria-hidden="true"></div>
    <div
      class="relative mx-auto max-w-content px-5 pb-[64vw] pt-10 md:grid md:h-[calc(100svh-5rem)] md:max-h-[56rem] md:min-h-[38rem] md:grid-cols-12 md:items-center md:gap-6 md:px-6 md:py-24"
    >
      <div class="reveal md:col-span-6">
        <!-- H1 from Carl (19 September 2026), set in sentence case; the subline is his meta description, plus one line -->
        <h1 class="text-display">Advanced facial treatments &amp; body sculpting in Dubai</h1>
        <p class="voice mt-6">
          A DHA-licensed beauty therapist specialising in acne-prone skin, facial sculpting, lymphatic drainage,
          Icoone body treatments and post-SMAS recovery. Personalised treatment plans with realistic goals and
          long-term results. Every session with Andreea herself.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4">
          <WhatsAppButton id="hero-cta" />
          <a href="/case-studies" class="link-arrow">
            <span>See before and after</span>
            <IconArrow class="h-4.5 w-4.5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. About me: arched portrait left; who she is and why her, right. White band. -->
  <section id="about" class="band bg-white">
    <div class="mx-auto max-w-content px-5 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6">
      <!-- The same portrait as the About page, so the two read as one person and one place -->
      <figure class="arch aspect-[4/5] bg-linen md:col-span-5">
        <Image
          src={photos.tunic.src}
          alt={photos.tunic.alt}
          widths={[480, 768, 1024]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover"
          style={`object-position:${photos.tunic.position}`}
        />
      </figure>
      <div class="mt-8 md:col-span-6 md:col-start-7 md:mt-0 md:pt-4">
        <Mark class="mb-4" />
        <h2 class="text-statement">About me</h2>
        <div class="voice mt-6">
          <p>
            I’m Andreea, an aesthetic professional based in Dubai, specialising in advanced facial and body
            treatments, skin health, facial sculpting and aesthetic technologies. I have lived and worked in the
            UAE for more than ten years.
          </p>
          <p>
            I believe good results start with understanding the person, not simply choosing a treatment. My
            approach is personal, practical and honest — I look at what you want to improve, what is suitable for
            you, and what can realistically achieve the best result.
          </p>
        </div>
        <ul class="mt-8 divide-y divide-linen border-y border-linen" role="list">
          {
            why.map((w) => (
              <li class="grid grid-cols-[2.75rem_1fr] gap-4 py-5">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-blush text-wine" aria-hidden="true">
                  <LineIcon name={w.icon} class="h-5.5 w-5.5" />
                </span>
                <div>
                  <h3 class="text-title font-medium">{w.title}</h3>
                  <p class="mt-1.5 max-w-[52ch] text-muted">{w.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a href="/about" class="link-arrow mt-6">
          <span>More about me</span>
          <IconArrow class="h-4.5 w-4.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Specialisations & qualifications -->
  <Section id="qualifications" title="Specialisations &amp; qualifications">
    <div slot="statement" class="mt-5 grid gap-5">
      <p class="voice max-w-[34ch]">
        {practitioner.title}. {practitioner.credentials.join(". ")}.
      </p>
      <a href="/qualifications" class="link-arrow">
        <span>Training and certificates</span>
        <IconArrow class="h-4.5 w-4.5" />
      </a>
    </div>
    <SpecialisationList idPrefix="home-specialisation" />
  </Section>

  <!-- 3. Treatments, with what Andreea does as the statement. White band. -->
  <Section id="treatments" title="Treatments" tone="white">
    <!-- Andreea’s own words (19 September 2026), as on the treatments page -->
    <div slot="statement" class="voice mt-5 max-w-[36ch]">
      <p>Your skin, your face, your goals — never a standard protocol.</p>
      <p>
        Every treatment starts with understanding what you want to improve. From acne and skin renewal to facial
        sculpting, lymphatic drainage and advanced technologies, each treatment is selected and adapted to your
        individual needs.
      </p>
    </div>
    <TreatmentRows items={treatments} />
    <a href="/treatments" class="link-arrow mt-6">
      <span>All treatments</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>

  <!-- Three photographs: two treatments in progress and the products -->
  <section class="pt-18 md:pt-32">
    <div class="mx-auto max-w-content px-5 md:px-6">
      <Gallery items={[photos.redlight, photos.forehead, photos.products]} columns={3} />
    </div>
  </section>

  <!-- 3b. Consultancy: the book under the statement, her three kinds of guidance as rows. White band. -->
  <Section id="consultancy" title="Consultancy" tone="white">
    <div slot="statement" class="mt-4 grid gap-8">
      <p class="voice max-w-[34ch]">
        For students, working therapists and new business owners in beauty and aesthetics.
      </p>
      <a href={bookHref} target="_blank" rel="noopener" class="block max-w-[14rem]">
        <Image src={photos.bookCover.src} alt={photos.bookCover.alt} widths={[448, 672]} sizes="14rem" loading="lazy" class="h-auto w-full" />
      </a>
    </div>
    <div class="voice">
      <p>
        In {book.published}, Andreea published <em>{book.title}</em>, a practical guide covering many of the
        questions she had to learn through experience when entering the industry. Alongside the book she offers
        personal guidance:
      </p>
    </div>
    <ul class="mt-8 divide-y divide-linen border-y border-linen" role="list">
      {
        GUIDANCE.map((g) => (
          <li class="py-5">
            <h3 class="text-title font-medium">{g.title}</h3>
            <p class="mt-1.5 max-w-[56ch] text-muted">{g.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
      <a href={bookHref} class="link-arrow" target="_blank" rel="noopener">
        <span>Get the book</span>
        <IconArrow class="h-4.5 w-4.5" />
      </a>
      <a href="/consultancy" class="link-arrow">
        <span>About consultancy</span>
        <IconArrow class="h-4.5 w-4.5" />
      </a>
    </div>
  </Section>

  <!-- Andreea’s method in her words: progress reviewed, plan adjusted (from “How it works”, step 3) -->
  <ImageBand
    photo={photos.faceMapping}
    title="Progress is reviewed at every stage, and the plan is adjusted when needed."
    text="Results with a plan. That is what the word lab means here."
  />

  <!-- Before and after: the visual focus on results -->
  {
    cases.length > 0 && (
      <section id="results" class="pt-18 md:pt-32">
        <div class="mx-auto max-w-content px-5 md:px-6">
          <div class="md:grid md:grid-cols-12 md:gap-6">
            <div class="md:col-span-5">
              <Mark class="mb-4" />
              <h2 class="text-statement">Before and after</h2>
            </div>
            <p class="voice mt-4 md:col-span-6 md:col-start-7 md:mt-0">
              One client, one plan: what they came in with, what was done, and the photographs before and
              after. Shared with the client’s permission.
            </p>
          </div>
          <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-6">
            {cases.map((c) => (
              <CaseStudyCard item={c} />
            ))}
          </div>
          <a href="/case-studies" class="link-arrow mt-8">
            <span>All case studies</span>
            <IconArrow class="h-4.5 w-4.5" />
          </a>
        </div>
      </section>
    )
  }

  <!-- Podcast: Andreea on YouTube (Carl, 19 September 2026). The video shows a photo until an episode ID is set. White band. -->
  {
    podcast.showSection && (
      <Section id="podcast" title="Podcast" tone="white">
        <div slot="statement">
          <p class="voice mt-4 max-w-[34ch]">Andreea’s podcast is on YouTube. Follow the channel for new episodes.</p>
          <div class="mt-6 flex flex-col items-start gap-3">
            <a href={youtube.channelUrl} class="link-arrow text-[0.95rem]" target="_blank" rel="noopener">
              <span>{t("cta.subscribeYoutube")}</span>
              <IconArrow class="h-4.5 w-4.5" />
            </a>
            <a href={contact.instagramUrl} class="link-arrow text-[0.95rem]" target="_blank" rel="noopener">
              <IconInstagram class="h-4.5 w-4.5" />
              <span>{t("cta.followInstagram")}</span>
            </a>
          </div>
        </div>
        <VideoEmbed
          title="Andreea’s Lab podcast"
          poster={photos.device}
          posterPosition="center 5%"
          youtubeId={youtube.featuredVideoId}
          caption={youtube.caption}
          channelUrl={youtube.channelUrl}
        />
      </Section>
    )
  }

  <!-- 4. FAQ. Blush band. -->
  <Section id="faq" title="Questions" tone="blush">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">The ones everyone asks first.</p>
    <FaqList items={faqs} />
    <a href="/faq" class="link-arrow mt-6">
      <span>All questions</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>

  <!-- 5. Contact -->
  <!-- Contact: WhatsApp and email only; the address is not published (Carl, 19 September 2026) -->
  <Section id="contact" title="Contact">
    <div slot="statement" class="mt-6 grid gap-5 text-facts">
      <p class="voice max-w-[34ch]">WhatsApp is the quickest way. Andreea replies personally, usually the same day.</p>
      <WhatsAppButton />
    </div>
    <dl class="border-t border-linen text-facts md:max-w-[30rem]">
      <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-linen py-3.5">
        <dt class="text-muted">WhatsApp</dt>
        <dd>
          <a href={whatsappLink()} class="text-ink tabular-nums underline hover:text-wine" target="_blank" rel="noopener">
            {contact.whatsappDisplay}
          </a>
        </dd>
      </div>
      <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-linen py-3.5">
        <dt class="text-muted">Email</dt>
        <dd>
          <a href={`mailto:${contact.email}`} class="break-all text-ink underline hover:text-wine">{contact.email}</a>
        </dd>
      </div>
    </dl>
    <p class="mt-5 text-facts text-muted">Based in {location.city}, UAE</p>
    <a href="/contact" class="link-arrow mt-6">
      <span>Contact page</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>
</BaseLayout>
