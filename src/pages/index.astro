---
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import TreatmentRows from "@/components/TreatmentRows.astro";
import Steps from "@/components/Steps.astro";
import Quote from "@/components/Quote.astro";
import Gallery from "@/components/Gallery.astro";
import ImageBand from "@/components/ImageBand.astro";
import HeroVideo from "@/components/HeroVideo.astro";
import VideoEmbed from "@/components/VideoEmbed.astro";
import CourseInterestForm from "@/components/CourseInterestForm.astro";
import MapEmbed from "@/components/MapEmbed.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import IconInstagram from "@/components/icons/IconInstagram.astro";
import LineIcon from "@/components/icons/LineIcon.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { addressLines } from "@/lib/address";
import { getFeaturedTreatments, getFeaturedTestimonials } from "@/lib/content";
import { getLocaleFromUrl, useTranslations } from "@/i18n/ui";

const t = useTranslations(getLocaleFromUrl(Astro.url));
const treatments = await getFeaturedTreatments(6);
const testimonials = await getFeaturedTestimonials(3);
const quotes = await Promise.all(
  testimonials.map(async (q) => ({ q, Content: (await render(q)).Content })),
);
const { location, practitioner, contact, courses, youtube } = SITE;

const steps = [
  {
    title: "Consultation",
    text: "Thirty minutes to talk, look and measure. You leave knowing whether the treatment is right for you.",
  },
  {
    title: "Plan",
    text: "Which areas, how many sessions, how often, and what to expect by when. In writing.",
  },
  {
    title: "Course of sessions",
    text: "Usually one or two a week. Each session builds on the last, and progress is measured.",
  },
  {
    title: "Maintenance",
    text: "Once you are where you want to be, a session every few weeks keeps you there.",
  },
];

const why = [
  {
    icon: "person",
    title: "One expert, every time.",
    text: "You see Andreea at every session, from the first consultation to the last check-in. No rotating staff.",
  },
  {
    icon: "shield",
    title: "Licensed and certified.",
    text: `${practitioner.title}. ${practitioner.credentials.join(", ")}. ${
      location.hostClinic
        ? `Working inside ${location.hostClinic}, a licensed clinic in ${location.area}.`
        : `Working from ${location.building}, ${location.area}, ${location.city}.`
    }`,
  },
  {
    icon: "clipboard",
    title: "A plan, not a pamper.",
    text: "Every course starts with a consultation and a written plan: which areas, how many sessions, what to expect and when.",
  },
  {
    icon: "heart",
    title: "Honest about results.",
    text: "No guarantees, no miracle language, and no pressure to add anything you did not come for.",
  },
] as const;
---

<BaseLayout title="Andreea’s Lab | Body and face treatments in Dubai" description={SITE.description} hasHero>
  <!-- Hero: statement and one button over a silent background video -->
  <section class="relative overflow-hidden">
    <HeroVideo poster="/video/hero-poster.jpg" mp4="/video/hero.mp4" webm="/video/hero.webm" />
    <div
      class="absolute inset-0 bg-linear-to-b from-porcelain from-35% via-porcelain/85 via-60% to-porcelain/15 md:bg-linear-to-r md:from-porcelain md:from-40% md:via-porcelain/80 md:via-58% md:to-porcelain/5"
      aria-hidden="true"></div>
    <div
      class="relative mx-auto max-w-content px-5 pb-[64vw] pt-10 md:grid md:min-h-[40rem] md:grid-cols-12 md:items-center md:gap-6 md:px-6 md:py-24"
    >
      <div class="reveal md:col-span-6">
        <h1 class="text-display">Body and face treatments in Dubai, with Andreea.</h1>
        <p class="voice mt-6">
          One licensed practitioner who plans every course and performs every session herself: lymphatic drainage,
          skin firming, body remodelling and recovery after surgery, using Icoone. Plain talk about what will work
          and what will not.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4">
          <WhatsAppButton id="hero-cta" />
          <a href="/treatments" class="link-arrow">
            <span>See treatments</span>
            <IconArrow class="h-4.5 w-4.5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Andreea: arched portrait left, facts with icons right. She comes first, on a white band. -->
  <section id="why" class="band bg-white">
    <div class="mx-auto max-w-content px-5 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6">
      <figure class="arch aspect-[4/5] bg-stone md:col-span-5">
        <Image
          src={photos.bowl.src}
          alt={photos.bowl.alt}
          widths={[480, 768, 1024]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover"
          style={`object-position:${photos.bowl.position}`}
        />
      </figure>
      <div class="mt-8 md:col-span-6 md:col-start-7 md:mt-0">
        <Mark class="mb-4" />
        <h2 class="text-statement">Why Andreea</h2>
        <ul class="mt-8 divide-y divide-stone border-y border-stone" role="list">
          {
            why.map((w) => (
              <li class="grid grid-cols-[2.75rem_1fr] gap-4 py-5">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-mist text-lab" aria-hidden="true">
                  <LineIcon name={w.icon} class="h-5.5 w-5.5" />
                </span>
                <div>
                  <h3 class="text-title font-medium">{w.title}</h3>
                  <p class="mt-1.5 max-w-[52ch] text-graphite">{w.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a href="/about" class="link-arrow mt-6">
          <span>More about Andreea</span>
          <IconArrow class="h-4.5 w-4.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Courses and videos: high up but secondary. Email interest and a click-to-load video. -->
  {
    courses.showSection && (
      <Section id="courses" title="Courses and videos">
        <div slot="statement">
          <div class="voice mt-4">
            <p>
              Andreea is preparing short courses in Dubai on how she works: the method, how a course is planned, and
              how to talk to clients plainly. They are for anyone who wants to learn to do what she does.
            </p>
            <p>Leave your email to hear first when dates are set. In the meantime, follow along on Instagram.</p>
          </div>
          <a href={contact.instagramUrl} class="link-arrow mt-6 text-[0.95rem]" target="_blank" rel="noopener">
            <IconInstagram class="h-4.5 w-4.5" />
            <span>{t("cta.followInstagram")}</span>
          </a>
        </div>
        <VideoEmbed
          title="Andreea’s Lab video"
          poster={photos.device}
          posterPosition="center 5%"
          youtubeId={youtube.featuredVideoId}
          mp4={youtube.placeholder.mp4}
          webm={youtube.placeholder.webm}
          caption={youtube.caption}
          channelUrl={youtube.channelUrl}
        />
        <div class="mt-10 border-t border-stone pt-8">
          <h3 class="text-title font-medium">Hear about courses first</h3>
          <CourseInterestForm class="mt-5 max-w-[26rem]" />
        </div>
      </Section>
    )
  }

  <Section id="treatments" title="Treatments" tone="white">
    <p slot="statement" class="voice mt-4 max-w-[36ch]">
      Six things, done properly. Each has a plan, a course and a clear price.
    </p>
    <TreatmentRows items={treatments} />
    <a href="/treatments" class="link-arrow mt-6">
      <span>All treatments</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>

  <Section id="method" title="What Andreea does">
    <div class="voice">
      <p>
        Andreea treats the body and face with Icoone, a non-invasive method from Italy. Small rollers move over the
        skin and gently stimulate the tissue beneath it, which helps fluid drain, softens tight areas and encourages
        the skin to firm.
      </p>
      <p>
        Sessions are comfortable and there is no downtime. Results build over a planned course rather than in one
        visit, which is why every course with Andreea starts with a consultation and a written plan.
      </p>
    </div>
  </Section>

  <!-- Three photographs: two treatments in progress and the products -->
  <section class="pt-10 md:pt-14">
    <div class="mx-auto max-w-content px-5 md:px-6">
      <Gallery items={[photos.redlight, photos.forehead, photos.products]} columns={3} />
    </div>
  </section>

  <ImageBand
    photo={photos.faceMapping}
    title="Every course is measured at the start and every few sessions, so the plan changes when the numbers do."
    text="Written down, checked, adjusted. That is what the word lab means here."
  />

  <Section id="how" title="How it works" tone="mist">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">Four steps. The order matters.</p>
    <Steps steps={steps} />
  </Section>

  <Section id="results" title="Results" tone="white">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">What clients say, in their own words.</p>
    <div class="grid gap-8">
      {
        quotes.map(({ q, Content }) => (
          <Quote name={q.data.name} area={q.data.area} date={q.data.date} placeholder={q.data.placeholder}>
            <Content />
          </Quote>
        ))
      }
    </div>
    <a href="/results" class="link-arrow mt-8">
      <span>More results</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>

  <Section id="location" title="Where to find me">
    <div slot="statement" class="mt-6 grid gap-5 text-facts">
      <address class="max-w-[36ch] not-italic">
        {location.hostClinic && <span class="block">{location.hostClinic}</span>}
        {addressLines.map((line) => <span class="block">{line}</span>)}
        {location.makani && <span class="block text-graphite tabular-nums">Makani {location.makani}</span>}
      </address>
      <dl class="grid gap-1.5 tabular-nums">
        {
          SITE.hours.map((h) => (
            <div class="flex justify-between gap-6 border-b border-stone pb-1.5 md:max-w-[22rem]">
              <dt class="text-graphite">{h.label}</dt>
              <dd>{h.closed ? "Closed" : `${h.opens} to ${h.closes}`}</dd>
            </div>
          ))
        }
      </dl>
      <p class="max-w-[40ch] text-graphite">{location.howToFind}</p>
    </div>
    <MapEmbed />
  </Section>

  <CtaBand />
</BaseLayout>
