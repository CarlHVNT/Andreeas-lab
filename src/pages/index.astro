---
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import TreatmentRows from "@/components/TreatmentRows.astro";
import Steps from "@/components/Steps.astro";
import Quote from "@/components/Quote.astro";
import MapEmbed from "@/components/MapEmbed.astro";
import CtaBand from "@/components/CtaBand.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import { SITE } from "@/site.config";
import { getFeaturedTreatments, getFeaturedTestimonials } from "@/lib/content";
import hero from "@/assets/placeholders/hero.jpg";
import portrait from "@/assets/placeholders/portrait.jpg";

const treatments = await getFeaturedTreatments(6);
const testimonials = await getFeaturedTestimonials(3);
const quotes = await Promise.all(
  testimonials.map(async (q) => ({ q, Content: (await render(q)).Content })),
);
const { location, practitioner } = SITE;

const steps = [
  {
    title: "Consultation",
    text: "Thirty minutes to talk, look and measure. You leave knowing whether Icoone is right for you.",
  },
  {
    title: "Plan",
    text: "Which areas, how many sessions, how often, and what to expect by when. In writing.",
  },
  {
    title: "Course of sessions",
    text: "Usually one or two a week. Each session builds on the last, and progress is measured.",
  },
  {
    title: "Maintenance",
    text: "Once you are where you want to be, a session every few weeks keeps you there.",
  },
];

const why = [
  {
    title: "One expert, every time.",
    text: "You see Andreea at every session, from the first consultation to the last check-in. No rotating staff.",
  },
  {
    title: "Licensed and certified.",
    text: `${practitioner.title}. ${practitioner.credentials.join(", ")}. Working inside ${location.hostClinic}, a licensed clinic in ${location.area}.`,
  },
  {
    title: "A plan, not a pamper.",
    text: "Every course starts with a consultation and a written plan: which areas, how many sessions, what to expect and when.",
  },
  {
    title: "Honest about results.",
    text: "No guarantees, no miracle language, and no pressure to add anything you did not come for.",
  },
];
---

<BaseLayout title="Icoone treatments in Dubai | Andreea’s Lab" description={SITE.description} hasHero>
  <!-- Hero: statement, one button, the photograph -->
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <div class="reveal md:col-span-5 md:pt-6">
      <h1 class="text-display">Icoone body and face treatments in Dubai.</h1>
      <p class="voice mt-6">
        Lymphatic drainage, skin firming, body remodelling and post-surgery recovery, planned as a course and
        performed by one licensed practitioner. Every session with Andreea.
      </p>
      <div class="mt-8 flex flex-col items-start gap-4">
        <WhatsAppButton id="hero-cta" />
        <a href="/treatments" class="link-arrow">
          <span>See treatments</span>
          <IconArrow class="h-4.5 w-4.5" />
        </a>
      </div>
    </div>
    <figure class="reveal-late -mx-5 mt-10 md:col-span-6 md:col-start-7 md:mx-0 md:mt-0">
      <Image
        src={hero}
        alt="Placeholder for a photograph of Andreea’s hands during an Icoone session"
        widths={[480, 768, 1024, 1600]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full object-cover"
      />
    </figure>
  </section>

  <Section id="icoone" title="What Icoone is">
    <div class="voice">
      <p>
        Icoone is a non-invasive body and face treatment from Italy. Small rollers move over the skin and gently
        stimulate the tissue beneath it, which helps fluid drain, softens tight areas and encourages the skin to
        firm.
      </p>
      <p>
        Sessions are comfortable and there is no downtime. Results build over a planned course rather than in
        one visit, which is why every course here starts with a consultation and a plan.
      </p>
    </div>
  </Section>

  <Section id="treatments" title="Treatments">
    <p slot="statement" class="voice mt-4 max-w-[36ch]">
      Six things, done properly. Each has a plan, a course and a clear price.
    </p>
    <TreatmentRows items={treatments} />
    <a href="/treatments" class="link-arrow mt-6">
      <span>All treatments</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>

  <!-- Why Andreea: portrait left, facts right -->
  <section id="why" class="pt-18 md:pt-32">
    <div class="mx-auto max-w-content px-5 md:grid md:grid-cols-12 md:gap-6 md:px-6">
      <figure class="md:col-span-5">
        <Image
          src={portrait}
          alt="Placeholder for a portrait of Andreea"
          widths={[480, 768, 1200]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading="lazy"
          class="aspect-[3/4] w-full object-cover"
        />
      </figure>
      <div class="mt-8 md:col-span-6 md:col-start-7 md:mt-0">
        <h2 class="text-statement">Why Andreea</h2>
        <ul class="mt-8 divide-y divide-stone border-y border-stone" role="list">
          {
            why.map((w) => (
              <li class="py-5">
                <h3 class="text-title font-medium">{w.title}</h3>
                <p class="mt-1.5 max-w-[52ch] text-graphite">{w.text}</p>
              </li>
            ))
          }
        </ul>
        <a href="/about" class="link-arrow mt-6">
          <span>More about Andreea</span>
          <IconArrow class="h-4.5 w-4.5" />
        </a>
      </div>
    </div>
  </section>

  <Section id="how" title="How it works" tone="mist">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">Four steps. The order matters.</p>
    <Steps steps={steps} />
  </Section>

  <Section id="results" title="Results">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">What clients say, in their own words.</p>
    <div class="grid gap-8">
      {
        quotes.map(({ q, Content }) => (
          <Quote
            name={q.data.name}
            area={q.data.area}
            date={q.data.date}
            placeholder={q.data.placeholder}
          >
            <Content />
          </Quote>
        ))
      }
    </div>
    <a href="/results" class="link-arrow mt-8">
      <span>More results</span>
      <IconArrow class="h-4.5 w-4.5" />
    </a>
  </Section>

  <Section id="location" title="Where to find me">
    <div slot="statement" class="mt-6 grid gap-5 text-facts">
      <p class="max-w-[36ch]">
        Inside {location.hostClinic}, {location.streetAddress}, {location.area}, {location.city}.
      </p>
      <dl class="grid gap-1.5 tabular-nums">
        {
          SITE.hours.map((h) => (
            <div class="flex justify-between gap-6 border-b border-stone pb-1.5 md:max-w-[22rem]">
              <dt class="text-graphite">{h.label}</dt>
              <dd>{h.closed ? "Closed" : `${h.opens} to ${h.closes}`}</dd>
            </div>
          ))
        }
      </dl>
      <p class="max-w-[40ch] text-graphite">{location.howToFind}</p>
    </div>
    <MapEmbed />
  </Section>

  <CtaBand />
</BaseLayout>
