---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import { SITE } from "@/site.config";
import { getCaseStudiesByGroup, getTreatments, treatmentPath } from "@/lib/content";

const groups = SITE.results.showBeforeAfters ? await getCaseStudiesByGroup() : [];
const treatments = await getTreatments();
const treatmentFor = (slug?: string) => (slug ? treatments.find((t) => t.id === slug) : undefined);
---

<BaseLayout
  title="Before and after"
  description="Before-and-after cases from Andreea’s Lab in Dubai, in two groups: facial treatments and facial massage. What the client came in with, what was done, and the photographs, shared with permission."
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-7">
      <Mark class="mb-4" />
      <h1 class="text-statement">Before and after</h1>
      <div class="voice mt-5">
        <p>
          Every case here is one client and one plan: what they came in with, what was done, and the
          photographs before the first session and after the last, shared with the client’s permission.
        </p>
        <p class="text-muted">
          Results vary from person to person, and these are not a promise about yours. That is what the
          consultation is for.
        </p>
      </div>
    </header>
  </section>

  <!-- One section per group (src/lib/case-groups.ts); the page and the quiet band alternate -->
  {
    groups.map((group, i) => (
      <section id={group.id} class:list={[i % 2 === 0 ? "pt-14 md:pt-20" : "band bg-white"]}>
        <div class="mx-auto max-w-content px-5 md:px-6">
          <div class="md:grid md:grid-cols-12 md:gap-6">
            <div class="md:col-span-5">
              <Mark class="mb-4" />
              <h2 class="text-statement">{group.label}</h2>
            </div>
            <p class="voice mt-4 max-w-[40ch] md:col-span-6 md:col-start-7 md:mt-0">{group.text}</p>
          </div>
          {group.items.length > 0 ? (
            <div class="mt-10 grid gap-12 md:grid-cols-3 md:gap-6">
              {group.items.map((c) => {
                const t = treatmentFor(c.data.treatmentSlug);
                return (
                  <CaseStudyCard
                    item={c}
                    treatmentTitle={t?.data.title}
                    treatmentHref={t ? treatmentPath(t) : undefined}
                    showGroup={false}
                  />
                );
              })}
            </div>
          ) : (
            <p class="mt-8 text-muted">Photographs will follow.</p>
          )}
        </div>
      </section>
    ))
  }

  <CtaBand
    title="Your turn."
    text="Tell Andreea what you would like to change. She will tell you honestly what she can do for it, and what she cannot."
  />
</BaseLayout>
