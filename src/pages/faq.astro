---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import FaqList from "@/components/FaqList.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import { photos } from "@/lib/photos";
import { getFaqs } from "@/lib/content";
import { faqJsonLd, markdownToText } from "@/lib/seo";

const faqs = await getFaqs();
const groups = [
  { key: "treatment", title: "About the treatment", intro: "What Icoone feels like, how long it takes, who it suits." },
  { key: "practical", title: "Practical", intro: "Getting here, what to wear, what to expect on the day." },
  { key: "policy", title: "Policies", intro: "Booking, cancellations and payment." },
] as const;

const jsonLd = [
  faqJsonLd(faqs.map((f) => ({ question: f.data.question, answer: markdownToText(f.body) }))),
];
---

<BaseLayout
  title="Questions about Icoone in Dubai"
  description="Does Icoone hurt, how many sessions do you need, how fast are results, who should not have it, and the practical details of visiting Andreea’s Lab in Dubai."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-7 md:pt-6">
      <Mark class="mb-4" />
      <h1 class="text-statement">Questions, answered plainly</h1>
      <p class="voice mt-5">
        If your question is not here, message Andreea. Anything about your own health belongs in the
        consultation, not on a web page.
      </p>
    </header>
    <figure class="arch hidden aspect-[4/5] bg-stone md:col-span-4 md:col-start-9 md:block">
      <Image
        src={photos.bowl.src}
        alt={photos.bowl.alt}
        widths={[320, 480, 720]}
        sizes="(min-width: 768px) 30vw, 100vw"
        loading="eager"
        class="h-full w-full object-cover"
        style={`object-position:${photos.bowl.position}`}
      />
    </figure>
  </section>

  {
    groups.map((g) => {
      const items = faqs.filter((f) => f.data.category === g.key);
      if (!items.length) return null;
      return (
        <Section title={g.title} id={g.key}>
          <p slot="statement" class="voice mt-4 max-w-[32ch] text-graphite">
            {g.intro}
          </p>
          <FaqList items={items} />
        </Section>
      );
    })
  }

  <CtaBand title="Still wondering?" text="Ask Andreea directly. Short questions welcome. She replies personally, usually the same day." />
</BaseLayout>
