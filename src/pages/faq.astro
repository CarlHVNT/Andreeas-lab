---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import FaqList from "@/components/FaqList.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import { photos } from "@/lib/photos";
import { getFaqs, getFaqsByGroup } from "@/lib/content";
import { faqJsonLd, markdownToText } from "@/lib/seo";

const faqs = await getFaqs();
// Two groups (Carl, 19 September 2026): clients, then beauty professionals. Labels in src/lib/faq-groups.ts.
const groups = await getFaqsByGroup();

const jsonLd = [
  faqJsonLd(faqs.map((f) => ({ question: f.data.question, answer: markdownToText(f.body) }))),
];
---

<BaseLayout
  title="Questions, answered plainly"
  description="Andreea answers the questions clients ask about treatments, acne, pigmentation, facial sculpting programmes and online consultations, and the questions beauty professionals ask about her consultancy and her book."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-7 md:pt-6">
      <Mark class="mb-4" />
      <h1 class="text-statement">Questions, answered plainly</h1>
      <p class="voice mt-5">
        If your question is not here, message Andreea. Anything about your own health belongs in the
        consultation, not on a web page.
      </p>
    </header>
    <figure class="arch hidden aspect-[4/5] bg-linen md:col-span-4 md:col-start-9 md:block">
      <Image
        src={photos.consultation.src}
        alt={photos.consultation.alt}
        widths={[320, 480, 720]}
        sizes="(min-width: 768px) 30vw, 100vw"
        loading="eager"
        class="h-full w-full object-cover"
        style={`object-position:${photos.consultation.position}`}
      />
    </figure>
  </section>

  {
    groups.map((g, i) => (
      <Section title={g.label} id={g.id} tone={i % 2 === 0 ? "white" : "ivory"}>
        <p slot="statement" class="voice mt-4 max-w-[32ch] text-muted">
          {g.text}
        </p>
        {g.items.length > 0 ? <FaqList items={g.items} /> : <p class="text-muted">Questions will follow.</p>}
      </Section>
    ))
  }

  <CtaBand title="Still wondering?" text="Ask Andreea directly. Short questions welcome. She replies personally, usually the same day." />
</BaseLayout>
