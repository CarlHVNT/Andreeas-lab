---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
---

<BaseLayout title="Thank you" description="Your request has been sent." noindex>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:gap-6 md:px-6 md:pt-16">
    <div class="md:col-span-7">
      <h1 class="text-statement">Thank you. Andreea will message you.</h1>
      <p class="voice mt-5">
        Your request has been sent. Andreea replies personally on WhatsApp, usually the same day. If it is
        urgent, message her directly.
      </p>
      <div class="mt-8 flex flex-col items-start gap-4">
        <WhatsAppButton />
        <a href="/" class="link-arrow text-[0.95rem]">
          <span>Back to the home page</span>
          <IconArrow class="h-4.5 w-4.5" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
