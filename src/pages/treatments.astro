---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import TreatmentRows from "@/components/TreatmentRows.astro";
import PhotoPair from "@/components/PhotoPair.astro";
import Steps from "@/components/Steps.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { getTreatments, getFeaturedCaseStudies, treatmentPath } from "@/lib/content";

const treatments = await getTreatments();
const cases = SITE.results.showBeforeAfters ? await getFeaturedCaseStudies(2) : [];
const treatmentFor = (slug: string) => treatments.find((t) => t.id === slug);
const { location } = SITE;

const steps = [
  {
    title: "Consultation",
    text: "Thirty minutes to talk, look and measure. You leave knowing whether Icoone is right for you.",
  },
  {
    title: "Plan",
    text: "Which areas, how many sessions, how often, and what to expect by when. In writing.",
  },
  {
    title: "Course of sessions",
    text: "Usually one or two a week. Each session builds on the last, and progress is measured.",
  },
  {
    title: "Maintenance",
    text: "Once you are where you want to be, a session every few weeks keeps you there.",
  },
];
---

<BaseLayout
  title="Icoone treatments in Dubai"
  description={`Icoone lymphatic drainage, cellulite and skin firming, body remodelling, post-surgery and post-natal recovery and face treatments in ${location.area}, Dubai. One practitioner, planned courses.`}
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-5">
      <Mark class="mb-4" />
      <h1 class="text-statement">Icoone treatments in {location.city}</h1>
      <div class="voice mt-5">
        <p>
          A small number of treatments, each with a clear purpose. Every one starts with a consultation and is
          planned as a course, because that is how Icoone works best.
        </p>
        <p>Not sure which fits? Start with the consultation, or message Andreea and describe what bothers you.</p>
      </div>
      <PhotoPair first={photos.device} second={photos.products} class="mt-10 hidden md:grid" />
    </header>
    <div class="mt-10 md:col-span-6 md:col-start-7 md:mt-0">
      <TreatmentRows items={treatments} headingLevel="h2" />
    </div>
  </section>

  <Section id="how" title="How it works" tone="blush">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">Four steps. The order matters.</p>
    <Steps steps={steps} />
  </Section>

  {
    cases.length > 0 && (
      <Section id="results" title="Before and after">
        <div slot="statement" class="mt-4 grid gap-5">
          <p class="voice max-w-[34ch]">
            One client, one plan, one course, photographed in the same light and shared with permission.
          </p>
          <a href="/case-studies" class="link-arrow">
            <span>All case studies</span>
            <IconArrow class="h-4.5 w-4.5" />
          </a>
        </div>
        <div class="grid gap-10 sm:grid-cols-2 sm:gap-6">
          {cases.map((c) => {
            const t = treatmentFor(c.data.treatmentSlug);
            return <CaseStudyCard item={c} treatmentTitle={t?.data.title} treatmentHref={t ? treatmentPath(t) : undefined} />;
          })}
        </div>
      </Section>
    )
  }

  <CtaBand
    title="Not sure where to start?"
    text="Tell Andreea what you would like to change. She will say plainly whether Icoone can help, and which treatment fits."
  />
</BaseLayout>
