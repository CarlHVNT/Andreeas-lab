---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import TreatmentRows from "@/components/TreatmentRows.astro";
import PhotoPair from "@/components/PhotoPair.astro";
import Steps from "@/components/Steps.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { whatsappLink } from "@/lib/whatsapp";
import { getTreatments, getFeaturedCaseStudies } from "@/lib/content";

const treatments = await getTreatments();
const cases = SITE.results.showBeforeAfters ? await getFeaturedCaseStudies(2) : [];

// Andreea’s own words (19 September 2026). Step 4 is drafted in the same voice, to confirm with her.
// Her “a course of sessions” in step 3 is set as “a series of sessions”: on this site, “course” is a teaching course.
const steps = [
  {
    title: "Consultation",
    text: "We discuss your concerns, treatment history and goals, and assess what may be suitable for you.",
  },
  {
    title: "Personalised plan",
    text: "I recommend the treatment or combination of treatments that best matches your needs, with clear expectations from the start.",
  },
  {
    title: "Treatment programme",
    text: "Depending on your goals, this may be a single treatment or a series of sessions. Progress is reviewed and the plan can be adjusted when needed.",
  },
  {
    title: "Follow-up",
    text: "We review how your skin has responded and agree what comes next, from occasional maintenance sessions to advice for your routine at home.",
  },
];
---

<BaseLayout
  title="Signature Facials in Dubai"
  description="Andreea’s Lab Signature Facials in Dubai: Christina BioPhyto acne facial, BioRePeel, microneedling, post-SMAS lymphatic facial, facial sculpting and lift massage, EMS. One practitioner, a consultation first, duration and price on every treatment."
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-5">
      <Mark class="mb-4" />
      <!-- Andreea’s own words, set exactly as she wrote them (19 September 2026) -->
      <h1 class="text-statement">Andreea’s Lab Signature Facials</h1>
      <p class="mt-3 font-serif text-title">Your skin, your face, your goals — never a standard protocol.</p>
      <div class="voice mt-6">
        <p>
          Every treatment starts with understanding what you want to improve. From acne and skin renewal to facial
          sculpting, lymphatic drainage and advanced technologies, each treatment is selected and adapted to your
          individual needs.
        </p>
        <p>
          Not sure where to start?{" "}
          <a href={whatsappLink("a consultation")} class="underline hover:text-wine" target="_blank" rel="noopener">
            Book a consultation
          </a>{" "}
          and we’ll
          create the right plan together.
        </p>
      </div>
      <PhotoPair first={photos.device} second={photos.products} class="mt-10 hidden md:grid" />
    </header>
    <div class="mt-10 md:col-span-6 md:col-start-7 md:mt-0">
      <TreatmentRows items={treatments} headingLevel="h2" />
    </div>
  </section>

  {
    cases.length > 0 && (
      <Section id="results" title="Before and after">
        <div slot="statement" class="mt-4 grid gap-5">
          <p class="voice max-w-[34ch]">
            One client, one plan, photographed before and after and shared with the client’s permission.
          </p>
          <a href="/case-studies" class="link-arrow">
            <span>All case studies</span>
            <IconArrow class="h-4.5 w-4.5" />
          </a>
        </div>
        <div class="grid gap-10 sm:grid-cols-2 sm:gap-6">
          {cases.map((c) => (
            <CaseStudyCard item={c} />
          ))}
        </div>
      </Section>
    )
  }

  <Section id="how" title="How it works" tone="blush">
    <p slot="statement" class="voice mt-4 max-w-[34ch]">A simple, personalised approach from consultation to maintenance.</p>
    <Steps steps={steps} />
  </Section>

  <CtaBand
    title="Not sure where to start?"
    text="Tell Andreea what you would like to change. She will say plainly whether she can help, and which treatment fits."
  />
</BaseLayout>
