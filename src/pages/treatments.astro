---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TreatmentRows from "@/components/TreatmentRows.astro";
import PhotoPair from "@/components/PhotoPair.astro";
import CtaBand from "@/components/CtaBand.astro";
import Mark from "@/components/Mark.astro";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { getTreatments } from "@/lib/content";

const treatments = await getTreatments();
const { location } = SITE;
---

<BaseLayout
  title="Body and face treatments in Dubai"
  description={`Body and face treatments with Andreea in ${location.area}, Dubai: Icoone lymphatic drainage, cellulite and skin firming, body remodelling, post-surgery and post-natal recovery and face treatments. One practitioner, planned courses.`}
>
  <section class="mx-auto max-w-content px-5 pt-10 md:grid md:grid-cols-12 md:items-start md:gap-6 md:px-6 md:pt-16">
    <header class="md:col-span-5">
      <Mark class="mb-4" />
      <h1 class="text-statement">Treatments with Andreea</h1>
      <div class="voice mt-5">
        <p>
          A small number of treatments, each with a clear purpose. Every one starts with a consultation and is
          planned as a course, because that is how Andreea works and how the results hold.
        </p>
        <p>Not sure which fits? Start with the consultation, or message Andreea and describe what bothers you.</p>
      </div>
      <PhotoPair first={photos.device} second={photos.products} class="mt-10 hidden md:grid" />
    </header>
    <div class="mt-10 md:col-span-6 md:col-start-7 md:mt-0">
      <TreatmentRows items={treatments} headingLevel="h2" />
    </div>
  </section>

  <CtaBand
    title="Not sure where to start?"
    text="Tell Andreea what you would like to change. She will say plainly whether she can help, and which treatment fits."
  />
</BaseLayout>
