---
/**
 * The closing call to action on every page. Left-aligned like everything else,
 * with one soft mist orb behind the button.
 */
import WhatsAppButton from "./WhatsAppButton.astro";
import IconArrow from "./icons/IconArrow.astro";

interface Props {
  title?: string;
  text?: string;
  treatment?: string;
  /** Hide the form link on the contact page itself */
  showFormLink?: boolean;
  /** Text of the form link, “Or send a request” by default */
  formLinkLabel?: string;
}
const {
  title = "Ready when you are.",
  text = "Message Andreea with what you would like help with. She replies personally, usually the same day.",
  treatment,
  showFormLink = true,
  formLinkLabel = "Or send a request",
} = Astro.props;
---

<section class="relative mt-18 overflow-hidden md:mt-32">
  <span
    class="orb orb-blush -bottom-56 -right-40 h-[30rem] w-[30rem] md:-bottom-72 md:right-[4%] md:h-[40rem] md:w-[40rem]"
    aria-hidden="true"></span>
  <div class="relative mx-auto max-w-content px-5 md:px-6">
    <div class="border-t border-linen pt-10 md:grid md:grid-cols-12 md:gap-6 md:pt-14">
      <div class="md:col-span-7">
        <h2 class="text-statement">{title}</h2>
        <p class="voice mt-4 max-w-[46ch]">{text}</p>
      </div>
      <div class="mt-8 flex flex-col items-start gap-4 md:col-span-4 md:col-start-9 md:mt-0 md:pt-2">
        <WhatsAppButton treatment={treatment} />
        {
          showFormLink && (
            <a href="/contact" class="link-arrow text-[0.95rem]">
              <span>{formLinkLabel}</span>
              <IconArrow class="h-4.5 w-4.5" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
