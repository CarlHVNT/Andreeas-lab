---
/**
 * Questions as plain <details> rows. No JavaScript needed.
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getLocaleFromUrl, useTranslations } from "@/i18n/ui";

interface Props {
  items: CollectionEntry<"faqs">[];
  /** Heading level for the questions */
  headingLevel?: "h2" | "h3";
}
const { items, headingLevel: Heading = "h3" } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));

const rendered = await Promise.all(
  items.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<div class="border-t border-linen">
  {
    rendered.map(({ item, Content }) => (
      <details class="group border-b border-linen" id={`faq-${item.id}`}>
        <summary class="flex cursor-pointer items-start justify-between gap-5 py-5 text-left">
          <Heading class="text-title font-medium text-ink group-hover:text-wine">{item.data.question}</Heading>
          <span
            class="relative mt-1.5 block h-5 w-5 shrink-0 text-wine before:absolute before:left-0 before:top-1/2 before:h-[1.5px] before:w-5 before:-translate-y-1/2 before:bg-current after:absolute after:left-1/2 after:top-0 after:h-5 after:w-[1.5px] after:-translate-x-1/2 after:bg-current after:transition-transform group-open:after:scale-y-0"
            aria-hidden="true"
          />
        </summary>
        <div class="facts pb-6 text-ink">
          <Content />
          {item.data.needsConfirmation && (
            <p class="mt-3 text-meta text-muted">{t("label.toConfirm")}</p>
          )}
        </div>
      </details>
    ))
  }
</div>
