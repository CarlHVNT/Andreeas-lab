---
/**
 * Click-to-load video. Until the reader presses play, the box shows a
 * photograph with a play button in the middle, so nothing from YouTube loads
 * with the page. With a YouTube ID the button embeds the privacy-enhanced
 * player in place; with an mp4/webm it plays that; with neither, the whole
 * image links to `href` (the channel) instead.
 */
import { Image } from "astro:assets";
import type { Photo } from "@/lib/photos";
import { getLocaleFromUrl, useTranslations } from "@/i18n/ui";
import IconArrow from "./icons/IconArrow.astro";

interface Props {
  /** Accessible name of the video, used as the player title */
  title: string;
  poster: Photo;
  /** Focal point for the crop, overrides the photo’s own */
  posterPosition?: string;
  /** Shape of the slot: 16:9, or square for artwork */
  aspect?: "video" | "square";
  /** The 11-character YouTube video ID */
  youtubeId?: string;
  /** A clip to play when there is no YouTube ID */
  mp4?: string;
  webm?: string;
  /** With nothing to play in place, the image links here */
  href?: string;
  /** Accessible label for that link */
  hrefLabel?: string;
  caption?: string;
  /** Link shown under the video, e.g. the YouTube channel */
  channelUrl?: string;
}
const { title, poster, posterPosition, aspect = "video", youtubeId, mp4, webm, href, hrefLabel, caption, channelUrl } =
  Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
const playable = Boolean(youtubeId || mp4 || webm);
const linked = !playable && Boolean(href);
const shape = aspect === "square" ? "aspect-square" : "aspect-video";
---

<figure>
  <div
    class:list={["relative w-full overflow-hidden bg-linen", shape]}
    data-video
    data-title={title}
    data-youtube-id={youtubeId || undefined}
    data-mp4={youtubeId ? undefined : mp4}
    data-webm={youtubeId ? undefined : webm}
  >
    <Image
      src={poster.src}
      alt={poster.alt}
      widths={[480, 768, 1024, 1254]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
      style={`object-position:${posterPosition ?? poster.position ?? "center"}`}
    />
    {
      playable && (
        <button
          type="button"
          class="group absolute inset-0 flex items-center justify-center"
          data-play
          aria-label={`${t("cta.playVideo")}: ${title}`}
        >
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-ivory/92 text-wine transition-colors group-hover:bg-ivory md:h-20 md:w-20">
            <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7 md:h-8 md:w-8" fill="currentColor" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
          </span>
        </button>
      )
    }
    {
      linked && (
        <a
          href={href}
          class="group absolute inset-0 flex items-center justify-center"
          target="_blank"
          rel="noopener"
          aria-label={hrefLabel ?? `${t("cta.watchYoutube")}: ${title}`}
        >
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-ivory/92 text-wine transition-colors group-hover:bg-ivory md:h-20 md:w-20">
            <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7 md:h-8 md:w-8" fill="currentColor" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
          </span>
        </a>
      )
    }
  </div>
  {
    (caption || channelUrl) && (
      <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 text-meta text-muted">
        {caption && <span class="max-w-[52ch]">{caption}</span>}
        {channelUrl && (
          <a href={channelUrl} class="link-arrow text-[0.95rem]" target="_blank" rel="noopener">
            <span>{t("cta.watchYoutube")}</span>
            <IconArrow class="h-4.5 w-4.5" />
          </a>
        )}
      </figcaption>
    )
  }
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((box) => {
    box.querySelector<HTMLButtonElement>("[data-play]")?.addEventListener("click", () => {
      const { youtubeId, mp4, webm, title } = box.dataset;
      if (youtubeId) {
        const frame = document.createElement("iframe");
        frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&rel=0`;
        frame.title = title ?? "Video";
        frame.allow = "autoplay; encrypted-media; picture-in-picture";
        frame.allowFullscreen = true;
        frame.referrerPolicy = "strict-origin-when-cross-origin";
        frame.className = "absolute inset-0 h-full w-full border-0";
        box.replaceChildren(frame);
        return;
      }
      const video = document.createElement("video");
      video.controls = true;
      video.playsInline = true;
      video.preload = "auto";
      video.className = "absolute inset-0 h-full w-full bg-ink object-contain";
      video.setAttribute("aria-label", title ?? "Video");
      const sources: [string | undefined, string][] = [
        [webm, "video/webm"],
        [mp4, "video/mp4"],
      ];
      for (const [src, type] of sources) {
        if (!src) continue;
        const source = document.createElement("source");
        source.src = src;
        source.type = type;
        video.append(source);
      }
      box.replaceChildren(video);
      video.play().catch(() => {
        /* the controls are there; the reader can press play */
      });
    });
  });
</script>
