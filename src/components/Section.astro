---
/**
 * The site’s standard section: statement on the left (5 columns), evidence on
 * the right (6 columns, starting at column 7). Stacks on phones.
 *
 * Sections carry top spacing only, so the gap between two sections is exactly
 * one unit. A tinted band (`tone` white or blush) sits on its own ground and
 * carries spacing on both sides; two bands in a row sit flush (see `.band`).
 */
import Mark from "./Mark.astro";

export interface Props {
  id?: string;
  title?: string;
  /** Heading level for the title, h2 by default */
  heading?: "h1" | "h2";
  /** Ground colour. Ivory is the page; white is the quiet band, blush the accent band. */
  tone?: "ivory" | "white" | "blush";
  /** Show the small mark above the title */
  ornament?: boolean;
  class?: string;
}
const {
  id,
  title,
  heading = "h2",
  tone = "ivory",
  ornament = true,
  class: cls = "",
} = Astro.props;
const Tag = heading;
const ground = { ivory: "pt-18 md:pt-32", white: "band bg-white", blush: "band bg-blush" }[tone];
---

<section id={id} class:list={[ground, cls]}>
  <div class="mx-auto max-w-content px-5 md:grid md:grid-cols-12 md:gap-6 md:px-6">
    <div class="md:col-span-5">
      {title && ornament && <Mark class="mb-4" />}
      {title && <Tag class="text-statement">{title}</Tag>}
      <slot name="statement" />
    </div>
    <div class="mt-8 md:col-span-6 md:col-start-7 md:mt-0">
      <slot />
    </div>
  </div>
</section>
