---
/**
 * Click-to-load Google Map. Until the reader asks, the box shows a photograph
 * of the clinic. Nothing from Google loads before that, which keeps the page
 * fast and private.
 */
import { Image } from "astro:assets";
import { SITE } from "@/site.config";
import { photos } from "@/lib/photos";
import { addressInlineWithUnit } from "@/lib/address";
import { getLocaleFromUrl, useTranslations } from "@/i18n/ui";

const t = useTranslations(getLocaleFromUrl(Astro.url));
const { location } = SITE;
const photo = photos.clinic;
---

<div id="map" class="relative aspect-[4/3] w-full overflow-hidden bg-stone" data-query={location.mapsEmbedQuery}>
  <Image
    src={photo.src}
    alt={photo.alt}
    widths={[480, 768, 1024]}
    sizes="(min-width: 768px) 50vw, 100vw"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover"
    style={`object-position:${photo.position ?? "center"}`}
  />
  <div
    class="absolute inset-x-0 bottom-0 flex flex-col items-start gap-3 bg-linear-to-t from-porcelain via-porcelain/90 to-porcelain/0 px-5 pb-5 pt-14"
  >
    <p class="max-w-[36ch] text-meta text-graphite">{addressInlineWithUnit}.</p>
    <div class="flex flex-wrap gap-3">
      <button type="button" id="load-map" class="btn-quiet h-11 bg-porcelain">{t("cta.loadMap")}</button>
      <a href={location.mapsUrl} class="link-arrow h-11 px-1" target="_blank" rel="noopener">{t("cta.openMaps")}</a>
    </div>
  </div>
</div>

<script>
  const box = document.getElementById("map");
  const btn = document.getElementById("load-map");
  btn?.addEventListener("click", () => {
    if (!box) return;
    const q = encodeURIComponent(box.dataset.query ?? "");
    const frame = document.createElement("iframe");
    frame.src = `https://www.google.com/maps?q=${q}&output=embed`;
    frame.title = "Map";
    frame.loading = "lazy";
    frame.referrerPolicy = "no-referrer-when-downgrade";
    frame.className = "absolute inset-0 h-full w-full border-0";
    box.replaceChildren(frame);
  });
</script>
