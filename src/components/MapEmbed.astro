---
/**
 * Click-to-load Google Map. Nothing from Google loads until the reader asks,
 * which keeps the page fast and private.
 */
import { SITE } from "@/site.config";
import { getLocaleFromUrl, useTranslations } from "@/i18n/ui";

const t = useTranslations(getLocaleFromUrl(Astro.url));
const { location } = SITE;
---

<div
  id="map"
  class="relative aspect-[4/3] w-full overflow-hidden bg-stone"
  data-query={location.mapsEmbedQuery}
>
  <div class="absolute inset-0 flex flex-col items-start justify-end gap-3 p-5">
    <p class="max-w-[32ch] text-meta text-graphite">
      {location.hostClinic}, {location.streetAddress}, {location.area}, {location.city}.
    </p>
    <div class="flex flex-wrap gap-3">
      <button type="button" id="load-map" class="btn-quiet h-11 bg-porcelain">{t("cta.loadMap")}</button>
      <a href={location.mapsUrl} class="link-arrow h-11 px-1" target="_blank" rel="noopener">{t("cta.openMaps")}</a>
    </div>
  </div>
</div>

<script>
  const box = document.getElementById("map");
  const btn = document.getElementById("load-map");
  btn?.addEventListener("click", () => {
    if (!box) return;
    const q = encodeURIComponent(box.dataset.query ?? "");
    const frame = document.createElement("iframe");
    frame.src = `https://www.google.com/maps?q=${q}&output=embed`;
    frame.title = "Map";
    frame.loading = "lazy";
    frame.referrerPolicy = "no-referrer-when-downgrade";
    frame.className = "absolute inset-0 h-full w-full border-0";
    box.replaceChildren(frame);
  });
</script>
