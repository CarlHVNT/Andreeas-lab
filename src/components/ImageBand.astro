---
/**
 * A full-width photograph with one statement over a soft ink scrim.
 * Used once, on the home page.
 */
import { Image } from "astro:assets";
import type { Photo } from "@/lib/photos";

interface Props {
  photo: Photo;
  title: string;
  text?: string;
}
const { photo, title, text } = Astro.props;
---

<section class="mt-18 md:mt-32">
  <div class="relative aspect-[4/3] max-h-[34rem] min-h-[22rem] w-full overflow-hidden bg-stone md:aspect-[21/9]">
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={[640, 1024, 1290]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
      style={`object-position:${photo.position ?? "center"}`}
    />
    <div class="absolute inset-0 bg-linear-to-t from-ink/75 via-ink/30 to-ink/0" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0">
      <div class="mx-auto max-w-content px-5 pb-10 md:px-6 md:pb-14">
        <h2 class="max-w-[22ch] text-statement text-porcelain">{title}</h2>
        {text && <p class="voice mt-3 max-w-[46ch] text-porcelain/90">{text}</p>}
      </div>
    </div>
  </div>
</section>
