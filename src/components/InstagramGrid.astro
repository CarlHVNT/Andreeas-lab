---
/**
 * A static, curated grid that links to the profile. No third-party widget.
 * Edit the list in src/lib/photos.ts (`instagramPhotos`) to change the tiles.
 */
import { Image } from "astro:assets";
import { SITE } from "@/site.config";
import { instagramPhotos } from "@/lib/photos";
import IconInstagram from "./icons/IconInstagram.astro";

const { contact } = SITE;
---

<ul class="grid grid-cols-3 gap-2 md:gap-3" role="list">
  {
    instagramPhotos.map((p) => (
      <li>
        <a
          href={contact.instagramUrl}
          target="_blank"
          rel="noopener"
          class="block aspect-square overflow-hidden bg-linen"
          aria-label={`Open @${contact.instagramHandle} on Instagram`}
        >
          <Image
            src={p.src}
            alt={p.alt}
            widths={[240, 400, 540]}
            sizes="(min-width: 768px) 200px, 33vw"
            loading="lazy"
            class="h-full w-full object-cover"
            style={`object-position:${p.position ?? "center"}`}
          />
        </a>
      </li>
    ))
  }
</ul>
<a href={contact.instagramUrl} target="_blank" rel="noopener" class="link-arrow mt-5 text-[0.95rem]">
  <IconInstagram class="h-4.5 w-4.5" />
  <span>@{contact.instagramHandle} on Instagram</span>
</a>
