---
/**
 * The logotype in the header: the face mark and the script wordmark side by
 * side, built from Andreea’s logo by scripts/brand-assets.mjs.
 */
import { Image } from "astro:assets";
import { SITE } from "@/site.config";
import lockup from "@/assets/brand/logo-lockup.png";

interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
---

<a href="/" class:list={["inline-flex items-center no-underline", cls]} aria-label={`${SITE.name}, home`}>
  <Image
    src={lockup}
    alt={SITE.name}
    height={48}
    densities={[1, 2]}
    loading="eager"
    class="h-10 w-auto md:h-12"
  />
</a>
