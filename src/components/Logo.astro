---
/**
 * Wordmark + placeholder mark.
 * The mark (a ring and a point) stands in for Andreea’s real logo until the
 * SVG files arrive. Replace the <svg> below and public/favicon.svg together.
 */
import { SITE } from "@/site.config";

interface Props {
  class?: string;
  /** Larger wordmark for the footer */
  size?: "header" | "footer";
}
const { class: cls = "", size = "header" } = Astro.props;
---

<a
  href="/"
  class:list={[
    "inline-flex items-center gap-2.5 font-serif font-medium tracking-[-0.01em] text-ink no-underline",
    size === "header" ? "text-[1.25rem]" : "text-[1.4rem]",
    cls,
  ]}
  aria-label={`${SITE.name}, home`}
>
  <svg class="h-6 w-6 shrink-0" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" class="fill-lab" />
    <circle cx="32" cy="32" r="15" fill="none" class="stroke-porcelain" stroke-width="3.5" />
    <circle cx="32" cy="32" r="5" class="fill-porcelain" />
  </svg>
  <span>{SITE.name}</span>
</a>
