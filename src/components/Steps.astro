---
/**
 * “How it works”. The one numbered list on the site, because it is the one
 * genuine sequence.
 */
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-8 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-10" role="list">
  {
    steps.map((s, i) => (
      <li class="grid grid-cols-[2.75rem_1fr] gap-4">
        <span
          class="flex h-11 w-11 items-center justify-center rounded-full bg-ivory font-serif text-[1.25rem] text-wine tabular-nums"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div>
          <h3 class="text-title font-medium">
            <span class="sr-only">Step {i + 1}: </span>
            {s.title}
          </h3>
          <p class="mt-1.5 max-w-[40ch] text-muted">{s.text}</p>
        </div>
      </li>
    ))
  }
</ol>
