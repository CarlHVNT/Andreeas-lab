---
/**
 * A small ornament above section titles, in the logo’s own language:
 * a pastel shape behind a single drawn line.
 */
interface Props {
  class?: string;
  size?: number;
}
const { class: cls = "", size = 18 } = Astro.props;
---

<svg
  class:list={["block text-wine", cls]}
  width={size}
  height={Math.round(size * 0.78)}
  viewBox="0 0 18 14"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="11" cy="7" r="6" class="fill-rose" />
  <path d="M1 12.5C5.5 11 9.5 6.5 17 1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
</svg>
