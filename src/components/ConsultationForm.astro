---
/**
 * Consultation request form, handled by Netlify Forms.
 * WhatsApp is the primary call to action; this is the fallback.
 */
import { getLocaleFromUrl, useTranslations } from "@/i18n/ui";

interface Props {
  treatment?: string;
}
const { treatment = "" } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<form
  name="consultation"
  method="POST"
  action="/contact/thanks"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="grid gap-5"
>
  <input type="hidden" name="form-name" value="consultation" />
  <input type="hidden" name="treatment" value={treatment} />
  <p class="hidden" aria-hidden="true">
    <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="grid gap-1.5">
    <label for="name" class="text-meta font-medium text-ink">{t("form.name")}</label>
    <input id="name" name="name" type="text" required autocomplete="name" class="field" />
  </div>

  <div class="grid gap-1.5">
    <label for="whatsapp" class="text-meta font-medium text-ink">{t("form.whatsapp")}</label>
    <input
      id="whatsapp"
      name="whatsapp"
      type="tel"
      inputmode="tel"
      required
      autocomplete="tel"
      placeholder="+971 5…"
      class="field"
    />
  </div>

  <div class="grid gap-1.5">
    <label for="help" class="text-meta font-medium text-ink">{t("form.help")}</label>
    <textarea id="help" name="help" rows="4" class="field" placeholder={t("form.helpPlaceholder")}></textarea>
  </div>

  <div class="grid gap-3">
    <button type="submit" class="btn-primary justify-self-start">{t("cta.send")}</button>
    <p class="max-w-[48ch] text-meta text-graphite">
      {t("form.privacy")}
      <a href="/privacy" class="underline hover:text-lab">Privacy policy</a>.
    </p>
  </div>
</form>
