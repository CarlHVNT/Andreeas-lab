---
/**
 * One before-and-after case. Andreea publishes each case as a single composite
 * image (before on the left, after on the right, her notes written on it). The
 * card shows it in a square frame so a row of cases lines up; `imagePosition`
 * is the focal point when the frame crops a taller image. Under it, only the
 * title; dates, treatment link, concern, plan and summary stay in the content
 * files but are not shown (Carl, 19 September 2026). Two separate photographs
 * (`before`, `after`) render side by side instead.
 */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"caseStudies">;
  headingLevel?: "h2" | "h3";
  /** Image sizes: a third of the page (home) or half (Before & after page) */
  size?: "third" | "half";
}
const { item, headingLevel: Heading = "h3", size = "third" } = Astro.props;
const { data } = item;
const sizes = size === "half" ? "(min-width: 768px) 45vw, 92vw" : "(min-width: 768px) 30vw, 92vw";
const pairSizes = size === "half" ? "(min-width: 768px) 22vw, 45vw" : "(min-width: 768px) 14vw, 45vw";
const lowerFirst = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
/** Stand-in images are labelled as such, per the content rules */
const alt = (text: string) => (data.placeholderImages ? `Placeholder for ${lowerFirst(text)}` : text);
---

<article class="grid content-start gap-5">
  {
    data.image ? (
      <figure class="aspect-square overflow-hidden bg-linen">
        <Image
          src={data.image}
          alt={alt(data.imageAlt ?? "Before and after photographs")}
          widths={[480, 720, 1080]}
          sizes={sizes}
          loading="lazy"
          class="h-full w-full object-cover"
          style={`object-position:${data.imagePosition ?? "center"}`}
        />
      </figure>
    ) : data.before && data.after ? (
      <div class="grid grid-cols-2 gap-2 md:gap-3">
        <figure class="relative aspect-[4/5] overflow-hidden bg-linen">
          <Image
            src={data.before}
            alt={alt(data.beforeAlt ?? "Before photograph")}
            widths={[320, 480, 720]}
            sizes={pairSizes}
            loading="lazy"
            class="h-full w-full object-cover"
          />
          <figcaption class="absolute left-2.5 top-2.5 rounded-ui bg-ivory/92 px-2 py-0.5 text-[0.75rem] font-medium text-ink">
            Before
          </figcaption>
        </figure>
        <figure class="relative aspect-[4/5] overflow-hidden bg-linen">
          <Image
            src={data.after}
            alt={alt(data.afterAlt ?? "After photograph")}
            widths={[320, 480, 720]}
            sizes={pairSizes}
            loading="lazy"
            class="h-full w-full object-cover"
          />
          <figcaption class="absolute left-2.5 top-2.5 rounded-ui bg-ivory/92 px-2 py-0.5 text-[0.75rem] font-medium text-ink">
            After
          </figcaption>
        </figure>
      </div>
    ) : null
  }
  <div>
    <Heading class="text-title font-medium text-ink">{data.title}</Heading>
    {data.placeholderImages && <p class="mt-3 text-meta text-muted">Photograph to follow.</p>}
  </div>
</article>
