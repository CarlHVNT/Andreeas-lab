---
/**
 * Treatments as hairline rows, not cards. Serif title, sans promise, one arrow.
 */
import type { CollectionEntry } from "astro:content";
import IconArrow from "./icons/IconArrow.astro";
import { treatmentPath } from "@/lib/content";

interface Props {
  items: CollectionEntry<"treatments">[];
  /** Render titles as h3 (default) or h2 on the treatments overview */
  headingLevel?: "h2" | "h3";
}
const { items, headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="border-t border-stone" role="list">
  {
    items.map((t) => (
      <li class="border-b border-stone">
        <a
          href={treatmentPath(t)}
          class="group grid grid-cols-[1fr_auto] items-start gap-4 py-5 no-underline md:py-6"
        >
          <div>
            <Heading class="text-title font-medium text-ink group-hover:text-lab">{t.data.title}</Heading>
            <p class="mt-1 max-w-[52ch] text-[0.95rem] leading-[1.45] text-graphite">{t.data.promise}</p>
          </div>
          <IconArrow class="mt-1.5 h-5 w-5 text-lab transition-transform group-hover:translate-x-0.5" />
        </a>
      </li>
    ))
  }
</ul>
